  <main>
    <section class="stage stage--entry is-active" id="entry" aria-labelledby="welcome-title">
      <div class="intro-panel">
        <p class="eyebrow">CERIMÓNIA DE LOBOLO</p>
        <p class="monogram" aria-hidden="true">D <span>&amp;</span> M</p>

        <h1 class="welcome-copy" id="welcome-title">
          Há momentos que merecem ser celebrados. Há histórias que merecem testemunhas.
          E há pessoas especiais que não poderiam ficar de fora deste dia.
        </h1>

        <p class="intro-names">
          Domingos Leão Seiva <span aria-hidden="true">&amp;</span> Marnela Alberto Faquira
        </p>

        <button class="button button--rose" id="discover" type="button">
          DESCOBRIR O MEU CONVITE
        </button>
      </div>
    </section>

    <section class="stage stage--identity" id="identity" aria-labelledby="identity-title">
      <div class="intro-panel identity-panel">
        <p class="eyebrow">CONVITE PESSOAL</p>
        <h2 class="identity-title" id="identity-title">
          Este convite foi preparado especialmente para pessoas importantes na nossa história.
        </h2>

        <form class="guest-form" id="guest-form" novalidate>
          <label for="guest-name">Nome do convidado ou grupo</label>
          <input
            id="guest-name"
            name="guest-name"
            type="text"
            autocomplete="name"
            placeholder="Escreva o nome do convite"
            aria-describedby="guest-error"
          >
          <p class="form-error" id="guest-error" role="alert"></p>
          <button class="button button--rose" type="submit">
            CONFIRMAR IDENTIDADE
          </button>
        </form>
      </div>
    </section>

    <section class="stage stage--suspense" id="suspense" aria-live="polite">
      <div class="suspense-content">
        <div class="suspense-monogram" aria-hidden="true">D <span>&amp;</span> M</div>
        <p class="suspense-message" id="suspense-message">
          Preparámos algo especial para ti...
        </p>
      </div>
    </section>

    <section class="stage stage--invitation" id="invitation" aria-label="Convite oficial">
      <article class="invitation-card" id="invitation-card">
        <svg class="floral floral--tl" viewBox="0 0 120 120" aria-hidden="true"><use href="#bouquet"/></svg>
        <svg class="floral floral--tr" viewBox="0 0 120 120" aria-hidden="true"><use href="#bouquet"/></svg>
        <svg class="floral floral--bl" viewBox="0 0 120 120" aria-hidden="true"><use href="#bouquet"/></svg>
        <svg class="floral floral--br" viewBox="0 0 120 120" aria-hidden="true"><use href="#bouquet"/></svg>

        <div class="invite-content">
          <h2 class="invite-heading">Convite</h2>

          <div class="divider" aria-hidden="true"><span>◆</span></div>

          <p class="invite-words">
            Com alegria e bênçãos, temos a honra de convidar-te<br>
            para celebrar a cerimónia de Lobolo de:
          </p>

          <p class="couple-name">Domingos Leão Seiva</p>
          <span class="ampersand" aria-hidden="true">&amp;</span>
          <p class="couple-name">Marnela Alberto Faquira</p>

          <div class="divider invite-divider" aria-hidden="true"><span>◆</span></div>

          <p class="event-date">Sábado, 28 de Novembro de 2026</p>
          <p class="event-time">Às 14h00</p>

          <span class="detail-label">LOCAL</span>
          <p class="venue">Limas 3, Dondo, Moçambique.</p>

          <span class="detail-label">REFERÊNCIA</span>
          <p class="reference">Antes do Armazém.</p>

          <div class="divider invite-divider" aria-hidden="true"><span>◆</span></div>

          <p class="guest-display">
            Convidado(s): <strong id="guest-display-name"></strong>
          </p>

          <p class="closing">Agradecemos antecipadamente a tua presença.</p>
        </div>
      </article>

      <button class="button revisit-button" id="revisit" type="button">
        REVER CONVITE
      </button>
    </section>
  </main>

  <script>
    // A validação acontece no navegador. Esta lista pode ser consultada no código-fonte;
    // serve apenas como controlo informal, não como autenticação segura.
    const authorizedGuests = [
      "Sr. Faquira e Sr. Pinto",
      "Maria e Helena Bero",
      "M. Elisa",
      "Minda",
      "Vany",
      "Rosa Augusto",
      "Paixão",
      "Omar e Marina",
      "João Vizinho",
      "Alzira",
      "Noca e Neldimiro",
      "Fátima",
      "Edma",
      "Ameha",
      "Paulo",
      "Wanda",
      "Flora",
      "Esmael",
      "Hevenilson e Cate",
      "Evandro"
    ];

    const stages = {
      entry: document.getElementById("entry"),
      identity: document.getElementById("identity"),
      suspense: document.getElementById("suspense"),
      invitation: document.getElementById("invitation")
    };

    function showStage(stageName) {
      Object.values(stages).forEach(stage => stage.classList.remove("is-active"));
      stages[stageName].classList.add("is-active");
      stages[stageName].scrollTop = 0;
    }

    function normalizeName(value) {
      return value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim()
        .replace(/\s+/g, " ")
        .toLocaleLowerCase("pt");
    }

    document.getElementById("discover").addEventListener("click", () => {
      showStage("identity");
      window.setTimeout(() => document.getElementById("guest-name").focus(), 450);
    });

    document.getElementById("guest-form").addEventListener("submit", event => {
      event.preventDefault();

      const input = document.getElementById("guest-name");
      const error = document.getElementById("guest-error");
      const enteredName = input.value.trim();
      const normalizedEnteredName = normalizeName(enteredName);

      if (!normalizedEnteredName) {
        error.textContent = "Escreve o nome do convidado para continuar.";
        input.focus();
        return;
      }

      const matchedGuest = authorizedGuests.find(
        guest => normalizeName(guest) === normalizedEnteredName
      );

      if (!matchedGuest) {
        error.textContent =
          "Não conseguimos localizar este nome na nossa lista de convidados. Verifica se o escreveste correctamente.";
        input.select();
        return;
      }

      error.textContent = "";
      document.getElementById("guest-display-name").textContent = matchedGuest;
      showStage("suspense");

      const suspenseMessage = document.getElementById("suspense-message");
      suspenseMessage.textContent = "Preparámos algo especial para ti...";

      window.setTimeout(() => {
        suspenseMessage.textContent =
          "É com enorme alegria que queremos contar contigo neste momento tão especial.";
      }, 1900);

      window.setTimeout(() => {
        showStage("invitation");
      }, 4200);
    });

    document.getElementById("revisit").addEventListener("click", () => {
      document.getElementById("guest-name").value = "";
      document.getElementById("guest-error").textContent = "";
      showStage("identity");
      window.setTimeout(() => document.getElementById("guest-name").focus(), 450);
    });
  </script>
</body>
</html>
