<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f8f0f1">
  <meta name="description" content="Convite para a cerimónia de Lobolo de Domingos Leão Seiva e Marnela Alberto Faquira.">
  <title>Convite — Domingos Leão Seiva &amp; Marnela Alberto Faquira</title>

  <style>
    :root {
      --paper: #fbf5f5;
      --rose: #a85f76;
      --rose-light: #e9bdc9;
      --rose-pale: #f3dfe4;
      --gold: #c4a456;
      --ink: #70545b;
      --leaf: #a7b493;
      --cream-flower: #f2dfce;
    }

    * {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
      background: #282627;
    }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(ellipse at 50% 20%, #fff 0%, #f8f0f1 62%, #f0e5e7 100%);
      font-family: Georgia, "Times New Roman", serif;
    }

    button,
    input {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    .stage {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      overflow-y: auto;
      padding: 22px;
      opacity: 0;
      visibility: hidden;
      transition: opacity .65s ease, visibility .65s ease;
    }

    .stage.is-active {
      opacity: 1;
      visibility: visible;
    }

    .stage--entry,
    .stage--identity {
      background:
        radial-gradient(circle at 15% 15%, rgba(255,255,255,.9), transparent 30%),
        linear-gradient(145deg, #f8f0f1, #efe2e4);
    }

    .intro-panel {
      position: relative;
      width: min(620px, 100%);
      padding: 56px 34px;
      text-align: center;
      background: rgba(255, 251, 250, .88);
      border: 1px solid rgba(196, 164, 86, .8);
      box-shadow: 0 20px 65px rgba(105, 73, 79, .13);
    }

    .intro-panel::before {
      position: absolute;
      inset: 10px;
      border: 1px solid rgba(196, 164, 86, .45);
      content: "";
      pointer-events: none;
    }

    .eyebrow {
      margin: 0 0 25px;
      color: var(--gold);
      font-family: Arial, sans-serif;
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .28em;
    }

    .monogram {
      margin: 0 0 20px;
      color: var(--rose);
      font-size: 3rem;
      font-style: italic;
    }

    .monogram span {
      color: var(--gold);
      font-size: 1.8rem;
    }

    .welcome-copy {
      max-width: 500px;
      margin: 0 auto;
      font-size: clamp(1.35rem, 5vw, 2rem);
      font-style: italic;
      font-weight: 400;
      line-height: 1.45;
    }

    .intro-names {
      margin: 27px 0 30px;
      color: var(--rose);
      font-size: clamp(1rem, 4vw, 1.3rem);
      letter-spacing: .04em;
    }

    .button {
      position: relative;
      z-index: 1;
      min-height: 50px;
      padding: 14px 22px;
      border: 1px solid var(--gold);
      cursor: pointer;
      font-family: Arial, sans-serif;
      font-size: .74rem;
      font-weight: 700;
      letter-spacing: .12em;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
      box-shadow: 0 9px 22px rgba(120, 79, 87, .15);
    }

    .button:focus-visible,
    input:focus-visible {
      outline: 3px solid rgba(196, 164, 86, .6);
      outline-offset: 3px;
    }

    .button--rose {
      color: #fff;
      background: var(--rose);
    }

    .identity-panel {
      width: min(540px, 100%);
    }

    .identity-title {
      margin: 0 auto 28px;
      font-size: clamp(1.35rem, 4.5vw, 1.8rem);
      font-style: italic;
      font-weight: 400;
      line-height: 1.45;
    }

    .guest-form {
      width: min(390px, 100%);
      margin: auto;
      text-align: left;
    }

    .guest-form label {
      display: block;
      margin-bottom: 9px;
      color: var(--rose);
      font-family: Arial, sans-serif;
      font-size: .78rem;
      font-weight: 600;
      letter-spacing: .05em;
    }

    .guest-form input {
      width: 100%;
      min-height: 54px;
      padding: 12px 15px;
      border: 1px solid rgba(168, 95, 118, .45);
      border-radius: 0;
      background: #fffafa;
      color: var(--ink);
      font-size: 1rem;
      text-align: center;
    }

    .guest-form input::placeholder {
      color: #aa9398;
    }

    .guest-form .button {
      width: 100%;
      margin-top: 9px;
    }

    .form-error {
      min-height: 42px;
      margin: 9px 0 0;
      color: #984b53;
      font-family: Arial, sans-serif;
      font-size: .83rem;
      line-height: 1.4;
      text-align: center;
    }

    .stage--suspense {
      color: #fffaf7;
      background:
        radial-gradient(circle, rgba(255,255,255,.12), transparent 35%),
        linear-gradient(145deg, #a86e7d, #875563);
      text-align: center;
    }

    .suspense-content {
      width: min(580px, 100%);
      padding: 24px;
    }

    .suspense-monogram {
      display: grid;
      width: 140px;
      height: 140px;
      margin: 0 auto 42px;
      place-items: center;
      border: 1px solid rgba(230, 205, 148, .9);
      border-radius: 50%;
      color: #fffaf7;
      font-size: 3rem;
      font-style: italic;
      animation: glow 2s ease-in-out infinite;
    }

    .suspense-monogram span {
      color: #e5cd94;
      font-size: 1.5rem;
    }

    .suspense-message {
      min-height: 76px;
      margin: 0;
      font-size: clamp(1.2rem, 4vw, 1.65rem);
      font-style: italic;
      line-height: 1.5;
    }

    @keyframes glow {
      50% {
        box-shadow: 0 0 45px rgba(230, 205, 148, .25);
        transform: scale(1.04);
      }
    }

    .stage--invitation {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 14px;
      padding: 18px 12px;
      background: #292728;
    }

    .invitation-card {
      position: relative;
      isolation: isolate;
      display: flex;
      width: min(780px, 100%);
      min-height: min(1050px, calc(100dvh - 75px));
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 72px 48px;
      border: 1px solid #e8e1df;
      background: var(--paper);
      box-shadow: 0 12px 36px rgba(0, 0, 0, .18);
      text-align: center;
    }

    .invitation-card::before {
      position: absolute;
      z-index: -1;
      inset: 27px;
      border: 1px solid rgba(196, 164, 86, .8);
      content: "";
    }

    .floral {
      position: absolute;
      z-index: -1;
      width: clamp(138px, 24vw, 215px);
      height: auto;
      opacity: .9;
      pointer-events: none;
    }

    .floral--tl {
      top: 30px;
      left: 28px;
    }

    .floral--tr {
      top: 30px;
      right: 28px;
      transform: scaleX(-1);
    }

    .floral--bl {
      bottom: 30px;
      left: 28px;
      transform: scaleY(-1);
    }

    .floral--br {
      right: 28px;
      bottom: 30px;
      transform: scale(-1);
    }

    .invite-content {
      position: relative;
      z-index: 1;
      width: min(600px, 100%);
    }

    .invite-heading {
      margin: 0;
      color: var(--rose);
      font-size: clamp(3rem, 8vw, 4.5rem);
      font-style: italic;
      font-weight: 500;
      line-height: 1;
    }

    .divider {
      display: flex;
      width: min(250px, 62%);
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin: 22px auto 24px;
      color: var(--gold);
    }

    .divider::before,
    .divider::after {
      height: 1px;
      flex: 1;
      background: var(--gold);
      content: "";
    }

    .divider span {
      font-size: .8rem;
    }

    .invite-words {
      margin: 0 auto 12px;
      color: #765d63;
      font-size: clamp(.98rem, 2.8vw, 1.2rem);
      font-style: italic;
      line-height: 1.65;
    }

    .couple-name {
      margin: 7px 0;
      color: var(--rose);
      font-size: clamp(1.55rem, 5.2vw, 2.45rem);
      font-weight: 400;
      letter-spacing: .12em;
      line-height: 1.25;
      text-transform: uppercase;
    }

    .ampersand {
      display: block;
      margin: 3px 0;
      color: var(--gold);
      font-size: 2rem;
      font-style: italic;
    }

    .invite-divider {
      margin-top: 20px;
      margin-bottom: 20px;
    }

    .event-date,
    .event-time,
    .venue,
    .reference,
    .guest-display,
    .closing {
      margin: 8px 0;
      color: #70565d;
      font-size: clamp(1rem, 3vw, 1.23rem);
      line-height: 1.5;
    }

    .event-date {
      font-size: clamp(1.05rem, 3.3vw, 1.35rem);
    }

    .event-time {
      margin-top: 0;
    }

    .detail-label {
      display: block;
      margin: 12px 0 2px;
      color: var(--gold);
      font-family: Arial, sans-serif;
      font-size: .69rem;
      font-weight: 700;
      letter-spacing: .16em;
    }

    .guest-display {
      margin-top: 16px;
      font-size: clamp(.92rem, 2.8vw, 1.13rem);
      font-style: italic;
    }

    .guest-display strong {
      color: var(--rose);
      font-weight: 700;
    }

    .closing {
      margin-top: 20px;
      color: #87666e;
      font-style: italic;
    }

    .revisit-button {
      flex: 0 0 auto;
      min-height: 42px;
      padding: 10px 18px;
      border-color: rgba(230, 205, 148, .8);
      color: #fff;
      background: #80535e;
      font-size: .68rem;
    }

    @media (max-width: 540px) {
      .stage {
        padding: 12px;
      }

      .intro-panel {
        padding: 48px 24px;
      }

      .stage--invitation {
        padding: 10px 8px;
      }

      .invitation-card {
        min-height: calc(100dvh - 72px);
        padding: 66px 25px;
      }

      .invitation-card::before {
        inset: 17px;
      }

      .floral {
        width: clamp(112px, 31vw, 155px);
      }

      .floral--tl {
        top: 19px;
        left: 18px;
      }

      .floral--tr {
        top: 19px;
        right: 18px;
      }

      .floral--bl {
        bottom: 19px;
        left: 18px;
      }

      .floral--br {
        right: 18px;
        bottom: 19px;
      }

      .invite-heading {
        font-size: clamp(2.7rem, 13vw, 3.5rem);
      }

      .divider {
        margin-top: 16px;
        margin-bottom: 18px;
      }

      .invite-divider {
        margin-top: 14px;
        margin-bottom: 14px;
      }

      .couple-name {
        letter-spacing: .08em;
      }

      .closing {
        margin-top: 13px;
      }
    }

    @media (max-height: 740px) {
      .invitation-card {
        min-height: auto;
        padding-top: 58px;
        padding-bottom: 58px;
      }

      .floral {
        width: 130px;
      }

      .invite-heading {
        font-size: 2.7rem;
      }

      .divider {
        margin-top: 13px;
        margin-bottom: 14px;
      }

      .invite-divider {
        margin-top: 12px;
        margin-bottom: 12px;
      }

      .closing {
        margin-top: 12px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }

    @media print {
      @page {
        size: A5 portrait;
        margin: 0;
      }

      html,
      body {
        width: 148mm;
        height: 210mm;
        background: var(--paper) !important;
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }

      .stage {
        position: static;
        display: none;
        width: 148mm;
        height: 210mm;
        padding: 0;
        overflow: hidden;
        opacity: 1;
        visibility: visible;
      }

      #invitation.is-active {
        display: flex;
        justify-content: center;
        background: var(--paper);
      }

      .invitation-card {
        width: 148mm;
        height: 210mm;
        min-height: 0;
        border: 0;
        box-shadow: none;
      }

      .revisit-button {
        display: none;
      }
    }
  </style>
</head>

<body>
  <!-- Ilustrações florais vectoriais para o convite, sem imagens externas. -->
  <svg aria-hidden="true" width="0" height="0" style="position:absolute">
    <defs>
      <g id="flower-large">
        <g fill="#e9bdc9">
          <ellipse cx="50" cy="17" rx="14" ry="25"/>
          <ellipse cx="50" cy="17" rx="14" ry="25" transform="rotate(45 50 50)"/>
          <ellipse cx="50" cy="17" rx="14" ry="25" transform="rotate(90 50 50)"/>
          <ellipse cx="50" cy="17" rx="14" ry="25" transform="rotate(135 50 50)"/>
